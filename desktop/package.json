{
  "name": "interview-prep",
  "version": "1.0.0",
  "main": "main.js",
  "homepage": "./",
  "description": "Interview Preparation Application",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "npm run build:client && electron-builder",
    "build:client": "cd ../client && npm run build",
    "build:server": "cd ../server && npm install --production"
  },
  "build": {
    "appId": "com.interviewprep.app",
    "productName": "Interview Prep",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "../client/dist/**/*",
      "../server/**/*",
      "!../server/node_modules/express/docs/**/*",
      "!../server/node_modules/*/README.md",
      "!../server/node_modules/*/CHANGELOG.md",
      "!../server/node_modules/**/*.map"
    ],
    "asar": true,
    "asarUnpack": [
      "../server/**"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server"
      },
      {
        "from": "../client/dist",
        "to": "client/dist"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "certificateFile": null,
      "certificatePassword": null,
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Interview Prep"
    },
    "portable": {
      "artifactName": "${productName}-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^7.5.0"
  }
}
