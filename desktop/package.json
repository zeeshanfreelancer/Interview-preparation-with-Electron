{
  "name": "interview-prep-desktop",
  "version": "1.0.0",
  "main": "main-simple.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "npm run build:client && electron-builder",
    "build:client": "cd ../client && npm run build"
  },
  "build": {
    "appId": "com.interviewprep.app",
    "productName": "Interview Prep",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main-simple.js",
      "preload.js",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../client/dist",
        "to": "client/dist"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}